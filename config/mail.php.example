<?php
/**
 * BoardTrack — Email Configuration Example
 * config/mail.php.example
 *
 * Copy this file to config/mail.php and fill in your actual SMTP credentials.
 * config/mail.php is ignored by git for security.
 */

// Set to false to disable all outgoing emails
define('MAIL_ENABLED',   true);

// SMTP Server (e.g., smtp.gmail.com, smtp.hostinger.com)
define('MAIL_HOST',      'smtp.gmail.com');

// SMTP Port (465 for SSL/SMTPS, 587 for TLS/STARTTLS)
define('MAIL_PORT',      465);

// SMTP Username (your email address)
define('MAIL_USERNAME',  'your-email@gmail.com');

// SMTP Password (use an App Password for Gmail)
define('MAIL_PASSWORD',  'your-app-password-here');

// From address and name
define('MAIL_FROM',      'your-email@gmail.com');
define('MAIL_FROM_NAME', APP_NAME);
