# BoardTrack — Apache Rewrite Rules
# public/.htaccess

Options -Indexes
Options -MultiViews

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Hostinger recommended setup:
    # - Point domain/subdomain document root to this `public` folder
    # - Keep RewriteBase as /
    RewriteBase /

    # If deployed under a subdirectory, use:
    # RewriteBase /boardtrack/

    # Allow real files and real directories to pass through untouched
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Route everything else to index.php
    RewriteRule ^(.*)$ index.php?url=$1 [QSA,L]
</IfModule>

# Block directory listings
<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>

# Security headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
</IfModule>

# Block access to hidden files (.env, .git, etc.)
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>